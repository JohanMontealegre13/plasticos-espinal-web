{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "../js/**/*.js",
    "../functions/**/*.js",
    "./*.mjs",
    "./unit/*.mjs",
    "./e2e/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
