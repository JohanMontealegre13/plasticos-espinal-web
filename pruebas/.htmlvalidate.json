{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "attribute-boolean-style": "off",
    "no-redundant-role": "off",
    "doctype-style": "off",
    "tel-non-breaking": "off",
    "multiple-labeled-controls": "warn",
    "no-redundant-for": "off",
    "no-implicit-input-type": "off"
  }
}
